<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up - GCash</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    body {
      background-color: var(--gcash-blue);
    }
    .signup-container {
      max-width: 414px;
      margin: 0 auto;
      padding: 40px 20px;
    }
    .signup-logo {
      text-align: center;
      margin-bottom: 30px;
    }
    .signup-logo-icon {
      width: 60px;
      height: 60px;
      background-color: var(--gcash-white);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 15px;
      font-size: 30px;
      font-weight: bold;
      color: var(--gcash-blue);
    }
    .signup-logo-text {
      color: var(--gcash-white);
      font-size: 24px;
      font-weight: bold;
    }
    .signup-form {
      background-color: var(--gcash-white);
      border-radius: 10px;
      padding: 30px;
    }
    .form-title {
      color: var(--gcash-blue);
      text-align: center;
      margin-bottom: 30px;
    }
    .form-button {
      background-color: var(--gcash-blue);
    }
    .form-link {
      color: var(--gcash-blue);
    }
    .error-message {
      color: red;
      text-align: center;
      margin-bottom: 15px;
      display: none;
    }
  </style>
</head>
<body>
  <div class="signup-container">
    <div class="signup-logo">
      <div class="signup-logo-icon">G</div>
      <div class="signup-logo-text">GCASH</div>
    </div>
    <section class="signup-form">
      <h1 class="form-title">Create Account</h1>
      <div class="error-message" id="error-message"></div>
      <form id="signup-form">
        <div class="form-group">
          <label class="form-label" for="firstName">First Name</label>
          <input type="text" class="form-input" id="firstName" name="first_name" placeholder="Enter your first name" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="lastName">Last Name</label>
          <input type="text" class="form-input" id="lastName" name="last_name" placeholder="Enter your last name" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="email">Email</label>
          <input type="email" class="form-input" id="email" name="email" placeholder="Enter your email" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input type="password" class="form-input" id="password" name="password1" placeholder="Create a password" required minlength="6">
        </div>
        <div class="form-group">
          <label class="form-label" for="confirmPassword">Confirm Password</label>
          <input type="password" class="form-input" id="confirmPassword" name="password2" placeholder="Confirm your password" required minlength="6">
        </div>
        <div class="form-check">
          <input type="checkbox" class="form-check-input" id="terms" required>
          <label class="form-check-label" for="terms">I agree to the Terms & Conditions</label>
        </div>
        <button type="submit" class="form-button" id="signup-btn">Create Account</button>
        <a href="/login" class="form-link">Already have an account? Sign In</a>
      </form>
    </section>
  </div>
  <script>
    document.getElementById('signup-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      const errorEl = document.getElementById('error-message');
      const btn = document.getElementById('signup-btn');
      errorEl.style.display = 'none';
      errorEl.textContent = '';

      const first_name = document.getElementById('firstName').value.trim();
      const last_name = document.getElementById('lastName').value.trim();
      const email = document.getElementById('email').value.trim();
      const password1 = document.getElementById('password').value;
      const password2 = document.getElementById('confirmPassword').value;

      if (!first_name || !last_name || !email || !password1 || !password2) {
        errorEl.textContent = 'All fields are required';
        errorEl.style.display = 'block';
        return;
      }
      if (password1 !== password2) {
        errorEl.textContent = 'Passwords do not match';
        errorEl.style.display = 'block';
        return;
      }
      if (password1.length < 6) {
        errorEl.textContent = 'Password must be at least 6 characters';
        errorEl.style.display = 'block';
        return;
      }

      btn.disabled = true;
      btn.textContent = 'Creating...';

      try {
        const res = await fetch('/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ first_name, last_name, email, password1, password2 }),
        });
        const data = await res.json();

        if (data.success) {
          if (data.user && data.user.email) {
            localStorage.setItem('pendingVerifyEmail', data.user.email);
          } else {
            localStorage.setItem('pendingVerifyEmail', email.toLowerCase());
          }
          window.location.href = data.redirect || '/verify-email';
          return;
        }

        let msg = data.message || 'Registration failed';
        if (data.errors) {
          const parts = [];
          if (data.errors.email) parts.push(data.errors.email);
          if (data.errors.password) parts.push(data.errors.password);
          if (data.errors.first_name) parts.push(data.errors.first_name);
          if (data.errors.last_name) parts.push(data.errors.last_name);
          if (data.errors.accNo) parts.push(data.errors.accNo);
          if (parts.length) msg = parts.join('. ');
        }
        errorEl.textContent = msg;
        errorEl.style.display = 'block';
      } catch (err) {
        console.error('Signup fetch error:', err);
        errorEl.textContent = 'An error occurred. Please try again.';
        errorEl.style.display = 'block';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Create Account';
      }
    });
  </script>
</body>
</html>
